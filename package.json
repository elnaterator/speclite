    "bin/",
    "skills/",
    "hooks/",
    "templates/",
    "plugins/",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".codex-plugin/"
  ],
  "scripts": {
    "install-plugin": "node bin/install.js"
  },
  "keywords": [
    "spec-driven",
    "workflow",
    "roadmap",
    "planning",
    "git",
    "claude-code",
    "copilot",
    "cursor",
    "codex",
    "opencode",
    "kiro",
    "agent-skills"
  ],
